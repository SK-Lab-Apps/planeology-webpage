---
/**
 * / — the landing page, built to convert: hero with the animated route, the
 * departures board of topics, how it works, the Hangar, the Daily Departure,
 * the rank ladder, three sample questions, instrument tiles, checked facts,
 * six guides, the FAQ and a final boarding pass.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import HeroBand from '@/components/HeroBand.astro';
import StoreBadge from '@/components/StoreBadge.astro';
import PhoneFrame from '@/components/PhoneFrame.astro';
import FlapText from '@/components/FlapText.astro';
import StatTile from '@/components/StatTile.astro';
import TierPill from '@/components/TierPill.astro';
import GuideCard from '@/components/GuideCard.astro';
import Faq from '@/components/Faq.astro';
import QrCode from '@/components/QrCode.astro';
import { ROUTES, NOUNS, STORE_NAME, TAGLINE, aircraftPath } from '@/config';
import { groups, aircraft, ranks, counts, getQuestion, getGroup } from '@/lib/app-data';
import { aircraftImage, rankImage, screenshot } from '@/lib/images';
import { aircraftAlt } from '@/lib/alt';
import { homeFaq } from '@/content/faq';
import { HOME_TRY_IDS } from '@/data/site-quiz';
import { faqPage, graph, mobileApplication, organization, website, type Seo } from '@/lib/seo';

const description =
  'An iPhone app that teaches how flight works, aviation history, airliners and airports in short daily lessons, with quizzes and a Hangar of 56 aircraft.';
const seo: Seo = {
  title: 'Planeology: Learn Aviation in Short Daily Lessons',
  description,
  path: ROUTES.home,
};
const appDescription =
  `${STORE_NAME} turns curiosity about airplanes into real knowledge: ${counts.lessons} short lessons in ${counts.groups} groups, ${counts.questions} quiz questions each with a one-line explanation, a five-question Daily Departure, and a Hangar of ${counts.aircraft} aircraft fact cards. For aviation enthusiasts; not flight training.`;
const jsonld = [
  graph([website(description), organization(), mobileApplication(appDescription), faqPage(homeFaq)]),
];

const guides = await getCollection('guides');
const featuredSlugs = ['how-do-planes-fly', 'is-turbulence-dangerous', 'why-was-concorde-retired', 'what-do-runway-numbers-mean', 'how-jet-engines-work', 'why-are-black-boxes-orange'];
const featured = featuredSlugs.map((s) => guides.find((g) => g.id === s)).filter((g) => !!g);
const extra = guides.filter((g) => !featuredSlugs.includes(g.id)).slice(0, Math.max(0, 6 - featured.length));
const guideCards = [...featured, ...extra];

const showcaseIds = ['wright-flyer-1903', 'supermarine-spitfire', 'boeing-747', 'concorde', 'lockheed-sr-71-blackbird', 'airbus-a380'];
const showcase = showcaseIds.map((id) => aircraft.find((a) => a.id === id)!).filter(Boolean);
const tryQs = HOME_TRY_IDS.map((id) => ({ ...getQuestion(id), group: getGroup(getQuestion(id).groupId) }));
const letters = ['A', 'B', 'C', 'D'];
const steps = [
  { n: '01', title: 'Read four short cards', body: 'Each lesson is four cards, a few sentences each, with the app\'s own illustrations. One idea per card, nothing left unexplained.', shot: 'lesson' as const, alt: 'The lesson screen: an illustration of two jets with lift arrows, the card title Speed and Thin Air, and a Did you know? panel' },
  { n: '02', title: 'Pass a five-question quiz', body: 'Every answer comes with a why. Score 80 percent and the lesson is cleared; miss, and it\'s a go-around with the explanations in hand.', shot: 'quiz' as const, alt: 'The quiz screen: a turbojet question with the right answer marked in green and a Why panel explaining it' },
  { n: '03', title: 'Park an aircraft in your Hangar', body: `Each lesson you pass parks its aircraft, from the Piper Cub to the SR-71, with a fact card and its sources. ${counts.aircraft} to collect.`, shot: 'hangar' as const, alt: 'The Hangar screen: a two-column grid of aircraft cards with bay numbers and tier pills' },
];
const groupGuides = (groupId: string) => guides.filter((g) => g.data.groupId === groupId);
---

<Base seo={seo} jsonld={jsonld}>
  <!-- 1. Hero -->
  <HeroBand>
    <div class="wrap pt-10 pb-14 md:pt-16 md:pb-20 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div>
        <p class="label !text-board-text mb-4">{STORE_NAME} · iPhone</p>
        <h1 class="text-[2.9rem] sm:text-[3.8rem] md:text-[4.6rem] leading-[0.96] m-0 max-w-[12ch]">Learn aviation, one short lesson at a time</h1>
        <p class="mt-5 mb-7 text-on-night-soft text-[1.2rem] leading-relaxed max-w-[46ch] text-pretty">
          Planeology turns curiosity about airplanes into real knowledge, a few minutes at a time: how a wing makes lift, why jets fly so high, what the runway numbers mean, and the stories behind {counts.aircraft} aircraft.
        </p>
        <div class="flex flex-wrap items-center gap-5">
          <StoreBadge ct="home-hero" height={48} priority />
          <p class="m-0 text-on-night-soft text-sm max-w-[26ch]">{counts.lessons} lessons · {counts.questions} questions · a new five-question challenge every day</p>
        </div>
      </div>
      <div class="justify-self-center lg:justify-self-end">
        <PhoneFrame src={screenshot('home')} alt="Planeology's Home screen: Welcome aboard, a boarding-pass rank card reading Avgeek, streak and aircraft tiles, and the next lesson on the flight plan" priority width={300} />
      </div>
    </div>
  </HeroBand>

  <!-- 2. Departures board -->
  <section class="wrap py-14" aria-labelledby="board-title">
    <div class="board night-band rounded-[26px] p-5 sm:p-7">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
        <h2 id="board-title" class="font-display text-[2rem] sm:text-[2.4rem] leading-none m-0 flex items-center gap-3">
          <span class="lamp" aria-hidden="true"></span>Departures
        </h2>
        <p class="label !text-board-muted m-0">{counts.groups} lesson groups · {counts.lessons} lessons</p>
      </div>
      <div class="board-head label !text-board-muted" aria-hidden="true">
        <span>Flight</span><span>Topic</span><span>Lessons</span><span>Status</span>
      </div>
      <ol class="list-none m-0 p-0">
        {groups.map((g, i) => {
          const gs = groupGuides(g.id);
          const href = gs.length ? `${ROUTES.learn}#g-${g.id}` : ROUTES.learn;
          return (
            <li class="board-row">
              <a href={href} class="board-link" aria-label={`${g.flight} ${g.title}: ${g.lessonIds.length} lessons, ${i === 0 ? 'boarding' : 'on time'}`}>
                <span class="board-cell board-flight"><FlapText text={g.flight} size="sm" tone="white" flip delay={i * 2} /></span>
                <span class="board-cell board-topic"><FlapText text={g.title} size="sm" flip delay={i * 2 + 6} /></span>
                <span class="board-cell board-lessons"><FlapText text={String(g.lessonIds.length)} size="sm" tone="white" flip delay={i * 2 + 28} /></span>
                <span class="board-cell board-status"><FlapText text={i === 0 ? 'BOARDING' : 'ON TIME'} size="sm" tone={i === 0 ? 'green' : 'amber'} flip delay={i * 2 + 32} /></span>
              </a>
            </li>
          );
        })}
      </ol>
      <p class="mt-4 mb-0 text-on-night-soft text-sm">Lesson groups open in order, like legs of a flight plan. Tap a row for the guides on that topic.</p>
    </div>
  </section>

  <!-- 3. How it works -->
  <section class="chart-paper py-14" aria-labelledby="how-title">
    <div class="wrap">
      <p class="label text-primary mb-1">How it works</p>
      <h2 id="how-title" class="font-display text-[2.2rem] sm:text-[2.8rem] leading-none m-0 mb-10 max-w-[20ch]">Short cards, a quiz with a why, and a Hangar that fills up</h2>
      <ol class="list-none m-0 p-0 grid gap-10 md:grid-cols-3">
        {steps.map((s) => (
          <li class="grid gap-4 justify-items-center text-center rise">
            <PhoneFrame src={screenshot(s.shot)} alt={s.alt} width={240} />
            <div>
              <p class="label text-primary mb-1">Beat {s.n}</p>
              <h3 class="font-display text-[1.6rem] font-bold leading-tight m-0 mb-2">{s.title}</h3>
              <p class="m-0 text-ink-secondary leading-relaxed max-w-[34ch] mx-auto">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Hangar showcase -->
  <section class="wrap py-14" aria-labelledby="hangar-title">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <p class="label text-primary mb-1">The {NOUNS.collection}</p>
        <h2 id="hangar-title" class="font-display text-[2.2rem] sm:text-[2.8rem] leading-none m-0">{counts.aircraft} aircraft to collect</h2>
      </div>
      <a href={ROUTES.aircraft} class="btn btn-ghost">See the whole Hangar</a>
    </div>
    <ul class="list-none m-0 p-0 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-6">
      {showcase.map((a) => (
        <li class="rise">
          <a href={aircraftPath(a.id)} class="showcase card block no-underline text-ink">
            <div class="showcase-art">
              <Picture src={aircraftImage(a.id)} alt={aircraftAlt(a)} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width: 64rem) 12rem, (min-width: 48rem) 30vw, 45vw" loading="lazy" decoding="async" />
            </div>
            <div class="p-3 grid gap-1.5 justify-items-start">
              <span class="font-semibold leading-tight text-[0.9375rem]">{a.name}</span>
              <TierPill tier={a.tier} label={a.tierLabel} />
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-ink-muted text-sm m-0">Drawn in a plain finish, like a spotter's recognition card. Four tiers, from Standard to Legendary.</p>
  </section>

  <!-- 5. Daily Departure -->
  <section class="wrap py-6" aria-labelledby="daily-title">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center night-band rounded-[26px] p-6 sm:p-10">
      <div>
        <p class="label !text-board-text mb-2">{NOUNS.daily}</p>
        <h2 id="daily-title" class="font-display text-[2.2rem] sm:text-[2.8rem] leading-none m-0 mb-4">Five questions. Sixty seconds. The same set for everyone.</h2>
        <p class="text-on-night-soft text-[1.1rem] leading-relaxed m-0 mb-6 max-w-[48ch]">
          Every day the app serves the same five questions to everyone, drawn from all {counts.questions}, with {counts.dailySeconds} seconds on the clock. Keep a streak, earn a boarding pass with your score, and send it to a friend who thinks they know planes.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <FlapText text="PL 301" size="md" tone="white" />
          <FlapText text="5 QS · 60 SEC" size="md" />
          <FlapText text="BOARDING" size="md" tone="green" />
        </div>
      </div>
      <div class="justify-self-center">
        <PhoneFrame src={screenshot('daily')} alt="The Daily Departure screen: a departures board reading PL301, 5 QS · 60 SEC, BOARDING, a yellow Board now button and a seven-day logbook of streaks" width={260} />
      </div>
    </div>
  </section>

  <!-- 6. Rank ladder -->
  <section class="wrap py-14" aria-labelledby="ranks-title">
    <p class="label text-primary mb-1">Ranks</p>
    <h2 id="ranks-title" class="font-display text-[2.2rem] sm:text-[2.8rem] leading-none m-0 mb-2">From Passenger to Aviation Legend</h2>
    <p class="text-ink-secondary m-0 mb-8 max-w-[52ch]">Your rank climbs with the lessons you finish. Seven patches, each a flight patch in its own color, and the whole flight plan flown by the last one.</p>
    <ol class="ladder list-none m-0 p-0">
      {ranks.map((r, i) => (
        <li class="ladder-step rise" style={`--rank:${r.color}`}>
          <div class="ladder-patch">
            <Picture src={rankImage(r.image)} alt={`${r.title} rank patch`} formats={['avif', 'webp']} fallbackFormat="webp" widths={[96, 144, 192]} sizes="80px" loading="lazy" decoding="async" />
          </div>
          <p class="label m-0">Rank {i + 1}</p>
          <p class="font-display text-[1.35rem] font-bold leading-tight m-0" style="color: var(--rank)">{r.title}</p>
          <p class="m-0 text-ink-muted text-sm leading-snug">{r.subtitle}</p>
          <p class="m-0 font-mono text-[0.75rem] text-ink-secondary">{r.lessons === 0 ? 'Day one' : `${r.lessons} lessons`}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 7. Try one -->
  <section class="chart-paper py-14" aria-labelledby="try-title">
    <div class="wrap wrap-narrow">
      <p class="label text-primary mb-1">Try one</p>
      <h2 id="try-title" class="font-display text-[2.2rem] sm:text-[2.8rem] leading-none m-0 mb-2">Three questions, each with a why</h2>
      <p class="text-ink-secondary m-0 mb-6">Tap an answer. The explanation is the point.</p>
      <ol class="list-none m-0 p-0 grid gap-4" id="try">
        {tryQs.map((q, i) => (
          <li class="try-q card p-5" data-correct={q.correctIndex}>
            <p class="label mb-1.5" style={`color:${q.group.accent}`}>{q.group.title}</p>
            <p class="font-display text-[1.45rem] font-bold leading-tight m-0 mb-3">{q.question}</p>
            <ul class="list-none m-0 p-0 grid gap-1.5" aria-label={`Answers to sample question ${i + 1}`}>
              {q.options.map((o, j) => (
                <li>
                  <button type="button" class="try-opt" data-choice={j}>
                    <span class="try-letter" aria-hidden="true">{letters[j]}</span><span>{o}</span>
                  </button>
                </li>
              ))}
            </ul>
            <div class="try-why" hidden>
              <p class="label text-sky mb-1">Why</p>
              <p class="m-0">{q.explanation}</p>
            </div>
            <noscript><p class="mt-3 mb-0 text-ink-secondary"><strong>{letters[q.correctIndex]}.</strong> {q.explanation}</p></noscript>
          </li>
        ))}
      </ol>
      <p class="mt-6 mb-0 text-ink-secondary">There are {counts.questions - tryQs.length} more in the app, and <a href={ROUTES.quiz} class="text-sky">fifteen more here</a>.</p>
    </div>
  </section>

  <!-- 8. Instrument tiles -->
  <section class="wrap py-10" aria-label="What's inside">
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <StatTile label="Lessons" value={counts.lessons} caption="four cards each" class="rise" />
      <StatTile label="Topics" value={counts.groups} caption="lesson groups" class="rise" />
      <StatTile label="Questions" value={counts.questions} caption="each with a why" class="rise" />
      <StatTile label="Aircraft" value={counts.aircraft} caption="in the Hangar" class="rise" />
    </div>
  </section>

  <!-- 9. Checked facts -->
  <section class="wrap py-10" aria-labelledby="facts-title">
    <div class="card card-raised p-6 sm:p-8 grid gap-6 md:grid-cols-[1fr_1.2fr] md:items-center">
      <div>
        <p class="label text-primary mb-1">Checked facts</p>
        <h2 id="facts-title" class="font-display text-[2rem] sm:text-[2.4rem] leading-none m-0">Every number has a source</h2>
      </div>
      <div class="text-ink-secondary leading-relaxed grid gap-3">
        <p class="m-0">Every number, date and record in the lessons is checked against official sources, such as FAA handbooks, NASA's aeronautics guides and national air and space museums, and each lesson lists the sources it was checked against.</p>
        <p class="m-0">Where good sources disagree, the lesson says so rather than picking a side. Names are given as text only; no endorsement is implied.</p>
      </div>
    </div>
  </section>

  <!-- 10. From the guides -->
  {guideCards.length > 0 && (
    <section class="wrap py-14" aria-labelledby="guides-title">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
          <p class="label text-primary mb-1">From the guides</p>
          <h2 id="guides-title" class="font-display text-[2.2rem] sm:text-[2.8rem] leading-none m-0">The questions people ask about planes</h2>
        </div>
        <a href={ROUTES.learn} class="btn btn-ghost">All guides</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {guideCards.map((g) => (
          <GuideCard slug={g.id} title={g.data.title} dek={g.data.dek} groupId={g.data.groupId} lead={g.data.lead} leadAlt={g.data.leadAlt} />
        ))}
      </div>
    </section>
  )}

  <!-- 11. FAQ -->
  <section class="chart-paper py-14" aria-labelledby="faq-title">
    <div class="wrap wrap-narrow">
      <p class="label text-primary mb-1">Questions</p>
      <h2 id="faq-title" class="font-display text-[2.2rem] sm:text-[2.8rem] leading-none m-0 mb-6">Before you board</h2>
      <Faq items={homeFaq} />
    </div>
  </section>

  <!-- 12. Final CTA -->
  <section class="wrap py-14" aria-labelledby="final-title">
    <div class="final night-band rounded-[26px] p-6 sm:p-10 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="label !text-board-text mb-2">Boarding pass · Gate open</p>
        <h2 id="final-title" class="font-display text-[2.4rem] sm:text-[3.2rem] leading-[0.98] m-0 mb-4 max-w-[14ch]">Your gate is open</h2>
        <p class="text-on-night-soft text-[1.1rem] leading-relaxed m-0 mb-6 max-w-[46ch]">{TAGLINE}. {counts.lessons} lessons, {counts.questions} questions, {counts.aircraft} aircraft, and a Daily Departure waiting every morning.</p>
        <StoreBadge ct="home-final" height={48} />
      </div>
      <div class="hidden lg:grid justify-items-center gap-2 bg-white rounded-[18px] p-4">
        <QrCode ct="home-final" size={128} />
        <p class="label m-0 !normal-case !tracking-[0.08em] text-center max-w-[14ch]">Scan to get it on your iPhone</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .board { overflow: hidden; }
  .lamp { width: 0.6rem; height: 0.6rem; border-radius: 999px; background: #5bd98a; box-shadow: 0 0 10px #5bd98a; }
  .board-head { display: none; }
  @media (min-width: 48rem) {
    .board-head { display: grid; grid-template-columns: 8rem 1fr 6rem 11rem; gap: 1rem; padding: 0 0.5rem 0.5rem; }
  }
  .board-row { border-top: 1px solid rgb(255 255 255 / 0.08); }
  .board-link {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'flight status' 'topic topic';
    gap: 0.5rem 0.75rem; align-items: center;
    padding: 0.75rem 0.5rem; text-decoration: none; color: inherit; border-radius: 10px;
  }
  .board-link:hover { background: rgb(255 255 255 / 0.05); }
  .board-cell { display: inline-flex; min-width: 0; }
  .board-flight { grid-area: flight; }
  .board-status { grid-area: status; justify-self: end; }
  .board-topic { grid-area: topic; }
  .board-lessons { display: none; }
  @media (min-width: 48rem) {
    .board-link { grid-template-columns: 8rem 1fr 6rem 11rem; grid-template-areas: 'flight topic lessons status'; gap: 1rem; }
    .board-lessons { display: inline-flex; grid-area: lessons; }
    .board-status { justify-self: start; }
  }
  .showcase { overflow: hidden; transition: transform 160ms ease, box-shadow 160ms ease; }
  .showcase:hover { transform: translateY(-2px); box-shadow: var(--shadow-raised); }
  .showcase-art { aspect-ratio: 16 / 9; background: linear-gradient(180deg, #eef0f5, #fbfaf6); }
  .showcase-art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ladder {
    display: grid; gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 40rem) { .ladder { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .ladder { grid-template-columns: repeat(7, minmax(0, 1fr)); } }
  .ladder-step {
    background: var(--color-surface); border-radius: var(--radius-card); box-shadow: var(--shadow-card);
    padding: 1rem; display: grid; gap: 0.2rem; justify-items: center; text-align: center;
    border-top: 4px solid var(--rank);
  }
  .ladder-patch { width: 5rem; margin-bottom: 0.4rem; }
  .ladder-patch :global(img) { width: 100%; height: auto; display: block; }
  .try-opt {
    width: 100%; display: flex; align-items: center; gap: 0.6rem; text-align: left;
    background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-tile);
    padding: 0.6rem 0.75rem; cursor: pointer; font-size: 1rem; font-weight: 600; color: var(--color-ink);
    transition: border-color 120ms ease, opacity 160ms ease;
  }
  .try-opt:hover { border-color: var(--color-ink-muted); }
  .try-letter {
    display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 8px; flex-shrink: 0;
    background: var(--color-sunken); color: var(--color-ink-muted); font-family: var(--font-mono); font-weight: 600; font-size: 0.8125rem;
  }
  .try-q.is-answered .try-opt { cursor: default; opacity: 0.55; }
  .try-q.is-answered .try-opt.is-right { opacity: 1; border-color: var(--color-success); background: rgb(24 121 78 / 0.08); }
  .try-q.is-answered .try-opt.is-right .try-letter { background: var(--color-success); color: #fff; }
  .try-q.is-answered .try-opt.is-wrong { opacity: 1; border-color: var(--color-danger); background: rgb(200 30 58 / 0.06); }
  .try-q.is-answered .try-opt.is-wrong .try-letter { background: var(--color-danger); color: #fff; }
  .try-why { margin-top: 0.75rem; padding: 0.75rem 0.9rem; border-radius: var(--radius-tile); background: rgb(36 89 196 / 0.07); border: 1px solid rgb(36 89 196 / 0.18); }
</style>

<script>
  for (const q of document.querySelectorAll<HTMLElement>('.try-q')) {
    const right = Number(q.dataset.correct);
    const opts = Array.from(q.querySelectorAll<HTMLButtonElement>('.try-opt'));
    for (const btn of opts) {
      btn.addEventListener('click', () => {
        if (q.classList.contains('is-answered')) return;
        q.classList.add('is-answered');
        const choice = Number(btn.dataset.choice);
        for (const o of opts) {
          o.disabled = true;
          const j = Number(o.dataset.choice);
          if (j === right) o.classList.add('is-right');
          else if (j === choice) o.classList.add('is-wrong');
        }
        const why = q.querySelector<HTMLElement>('.try-why');
        if (why) why.hidden = false;
      });
    }
  }
</script>
