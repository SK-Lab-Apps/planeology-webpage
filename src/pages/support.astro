---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import { CONTACT_EMAIL, ROUTES, NOUNS } from '@/config';
import { supportFaq } from '@/content/faq';
import { breadcrumbList, faqPage, graph, organization, type Seo } from '@/lib/seo';

const seo: Seo = {
  title: 'Support',
  description:
    'Help with the Planeology app: how to reach us, restoring purchases, canceling a subscription, refunds through Apple, where progress lives, and deletion.',
  path: ROUTES.support,
};
const crumbs = [{ name: 'Home', path: ROUTES.home }, { name: 'Support', path: ROUTES.support }];
const plain = (html: string) => html.replace(/<[^>]+>/g, '');
const jsonld = [graph([organization(), breadcrumbList(crumbs), faqPage(supportFaq.map((f) => ({ question: f.question, answer: plain(f.answer) })))])];
---
<Base seo={seo} jsonld={jsonld} current="support">
  <div class="chart-paper">
    <div class="wrap wrap-narrow pt-6 pb-12">
      <Breadcrumbs items={crumbs} />
      <header class="mt-7 mb-8">
        <p class="label text-primary mb-2">Ground crew</p>
        <h1 class="text-[2.6rem] sm:text-[3.4rem] leading-[1] m-0">Support</h1>
        <p class="mt-3 text-[1.15rem] text-ink-secondary leading-relaxed max-w-[54ch]">Planeology is made by one independent developer, and every message is read. Here is how to reach us, and the answers to the questions we get most.</p>
      </header>

      <section class="grid gap-4 sm:grid-cols-2 mb-10" aria-labelledby="reach">
        <h2 id="reach" class="sr-only">How to reach us</h2>
        <div class="card p-5">
          <p class="label mb-1.5">Fastest</p>
          <p class="font-display text-[1.6rem] font-bold m-0 mb-2">The support button in the app</p>
          <p class="m-0 text-ink-secondary leading-relaxed">On the Home screen, tap the chat button. Your message comes with the app's random ID, which is how we can find anything about your copy of the app, since there are no accounts. Replies arrive in the same chat, in your language.</p>
        </div>
        <div class="card p-5">
          <p class="label mb-1.5">By email</p>
          <p class="font-display text-[1.6rem] font-bold m-0 mb-2 break-words"><a href={`mailto:${CONTACT_EMAIL}`} class="text-ink no-underline hover:text-primary">{CONTACT_EMAIL}</a></p>
          <p class="m-0 text-ink-secondary leading-relaxed">Good for anything that is easier to write at length. For questions about your purchase or your data, writing from the app helps us find your copy of it.</p>
        </div>
      </section>

      <section aria-labelledby="answers">
        <p class="label text-primary mb-1">Short answers</p>
        <h2 id="answers" class="font-display text-[1.9rem] font-bold m-0 mb-4">Common questions</h2>
        <Faq items={supportFaq} />
      </section>

      <p class="mt-10 text-ink-muted text-[0.9375rem] leading-relaxed">
        Planeology is for aviation enthusiasts. It is not flight training, and it is not affiliated with any airline or aircraft manufacturer. The {NOUNS.pass} is sold through Apple; our <a href={ROUTES.terms} class="text-sky">Terms of Use</a> and <a href={ROUTES.privacy} class="text-sky">Privacy Policy</a> have the details.
      </p>
    </div>
  </div>
</Base>
