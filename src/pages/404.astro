---
import Base from '@/layouts/Base.astro';
import HeroBand from '@/components/HeroBand.astro';
import FlapText from '@/components/FlapText.astro';
import { ROUTES } from '@/config';
import type { Seo } from '@/lib/seo';
const seo: Seo = {
  title: 'Page not found',
  description: 'That page is not on the chart. Head back to the Planeology home page, the guides, the Hangar or the glossary to keep learning about aviation.',
  path: '/404',
  noindex: true,
};
---
<Base seo={seo}>
  <HeroBand loop={false}>
    <div class="wrap py-16 md:py-24 grid gap-5 justify-items-start">
      <div class="flex flex-wrap items-center gap-3">
        <FlapText text="FLIGHT 404" size="md" />
        <FlapText text="DIVERTED" size="md" tone="white" />
      </div>
      <h1 class="text-[2.8rem] sm:text-[4rem] leading-[0.98] m-0 max-w-[14ch]">That page isn't on the chart</h1>
      <p class="text-on-night-soft text-[1.15rem] max-w-[46ch] m-0">The link may be old or mistyped. Everything on the site is one of these.</p>
      <div class="flex flex-wrap gap-3 mt-2">
        <a href={ROUTES.home} class="btn btn-signal">Home</a>
        <a href={ROUTES.learn} class="btn btn-night-ghost">Guides</a>
        <a href={ROUTES.aircraft} class="btn btn-night-ghost">Hangar</a>
        <a href={ROUTES.glossary} class="btn btn-night-ghost">Glossary</a>
      </div>
    </div>
  </HeroBand>
</Base>
