---
/** The "Did you know?" callout, in the lesson group's tint. Pass `source` for the publisher credit. */
interface Props { source?: string }
const { source } = Astro.props;
---
<aside class="dyk not-prose">
  <p class="label text-sky mb-1.5 flex items-center gap-1.5">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5a4.5 4.5 0 0 0-2.6 8.17c.4.3.6.75.6 1.23V11.5h4v-.6c0-.48.2-.93.6-1.23A4.5 4.5 0 0 0 8 1.5ZM6.5 13h3M7 14.5h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    Did you know?
  </p>
  <div class="dyk-body"><slot /></div>
  {source && <p class="dyk-src">Source: {source}</p>}
</aside>
<style>
  .dyk {
    margin-block: 2rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-card);
    background: rgb(36 89 196 / 0.07);
    border: 1px solid rgb(36 89 196 / 0.18);
  }
  .dyk-body { font-size: 1.0625rem; line-height: 1.55; color: var(--color-ink); }
  .dyk-body :global(p) { margin: 0; }
  .dyk-src { margin: 0.6rem 0 0; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-muted); }
</style>
