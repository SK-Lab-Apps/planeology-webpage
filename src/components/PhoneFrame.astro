---
/** A plain phone frame around a real screenshot (no photos, no device branding). */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  priority?: boolean;
  /** Rendered width of the phone in CSS px at the largest breakpoint. */
  width?: number;
}
const { src, alt, class: cls = '', priority = false, width = 300 } = Astro.props;
---
<figure class:list={['phone', cls]} style={`--phone-w:${width}px`}>
  <div class="phone-screen">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[320, 480, 640, 780]}
      sizes={`(min-width: 48rem) ${width}px, 70vw`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      pictureAttributes={{ class: 'block' }}
    />
  </div>
  <span class="phone-island" aria-hidden="true"></span>
</figure>

<style>
  .phone {
    position: relative;
    width: min(var(--phone-w), 100%);
    margin: 0;
    padding: 0.55rem;
    border-radius: 2.6rem;
    background: #0a1529;
    box-shadow: 0 24px 48px rgb(10 21 41 / 0.35), inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .phone-screen {
    overflow: hidden;
    border-radius: 2.1rem;
    aspect-ratio: 1320 / 2868;
    background: #12233f;
  }
  .phone-screen :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .phone-island {
    position: absolute;
    top: 1.05rem;
    left: 50%;
    width: 28%;
    height: 0.95rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0a1529;
  }
</style>
