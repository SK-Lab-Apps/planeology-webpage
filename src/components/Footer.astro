---
import { ROUTES, PUBLISHER, storeLink } from '@/config';
import Logo from '@/components/Logo.astro';
const year = 2026;
const cols = [
  { heading: 'Learn', links: [
    { href: ROUTES.learn, label: 'Guides' },
    { href: ROUTES.aircraft, label: 'Hangar' },
    { href: ROUTES.glossary, label: 'Glossary' },
    { href: ROUTES.phonetic, label: 'Phonetic alphabet' },
    { href: ROUTES.quiz, label: 'Quiz' },
  ]},
  { heading: 'Planeology', links: [
    { href: ROUTES.support, label: 'Support' },
    { href: ROUTES.privacy, label: 'Privacy' },
    { href: ROUTES.terms, label: 'Terms' },
  ]},
];
---
<footer class="bg-night text-white mt-16">
  <div class="wrap py-12 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="grid gap-4 content-start">
      <a href={ROUTES.home} class="flex items-center gap-2.5 no-underline text-white w-fit" aria-label="Planeology home">
        <Logo class="h-8 w-8" />
        <span class="font-display text-2xl font-bold tracking-tight leading-none">Planeology</span>
      </a>
      <p class="text-on-night-soft max-w-sm text-[0.9375rem] leading-relaxed">
        Learn aviation in short lessons: how flight works, aviation history, airliners, military aviation and airports.
      </p>
      <a href={storeLink('home-final')} rel="noopener" class="w-fit">
        <img src="/badges/download-on-the-app-store.svg" alt="Download on the App Store" width="120" height="40" loading="lazy" />
      </a>
    </div>
    {cols.map((c) => (
      <div>
        <h2 class="label !text-board-muted mb-3">{c.heading}</h2>
        <ul class="list-none m-0 p-0 grid gap-2">
          {c.links.map((l) => (
            <li><a href={l.href} class="text-white/90 no-underline hover:underline">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-white/10">
    <div class="wrap py-5 flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between text-[0.8125rem] text-on-night-soft">
      <p class="m-0">Not affiliated with any airline or aircraft manufacturer. For aviation enthusiasts, not flight training.</p>
      <p class="m-0 font-mono">© {year} {PUBLISHER}</p>
    </div>
  </div>
</footer>
