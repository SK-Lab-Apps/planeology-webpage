---
import { getCollection } from 'astro:content';
import GuideCard from '@/components/GuideCard.astro';
interface Props { slugs: string[]; title?: string }
const { slugs, title = 'Keep reading' } = Astro.props;
const all = await getCollection('guides');
const picked = slugs.map((s) => all.find((g) => g.id === s)).filter((g) => !!g);
---
{picked.length > 0 && (
  <section class="my-10" aria-labelledby="related-guides">
    <p class="label text-primary mb-1">Guides</p>
    <h2 id="related-guides" class="font-display text-[1.9rem] font-bold m-0 mb-4">{title}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {picked.map((g) => (
        <GuideCard slug={g.id} title={g.data.title} dek={g.data.dek} groupId={g.data.groupId} lead={g.data.lead} leadAlt={g.data.leadAlt} compact />
      ))}
    </div>
  </section>
)}
