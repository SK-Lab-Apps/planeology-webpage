---
/**
 * BoardingPass — the CTA card: a main panel, a perforation with half-circle
 * notches, and a stub holding the badge (and a QR code on desktop).
 */
import StoreBadge from '@/components/StoreBadge.astro';
import QrCode from '@/components/QrCode.astro';
import { NOUNS, type Campaign } from '@/config';
import { counts } from '@/lib/app-data';

interface Props {
  ct: Campaign;
  eyebrow?: string;
  title: string;
  body: string;
  /** Mono label on the stub. */
  stubLabel?: string;
  class?: string;
  /** Background behind the card, so the notches match it. */
  bg?: 'paper' | 'surface' | 'night';
}
const {
  ct,
  eyebrow = 'Boarding pass',
  title,
  body,
  stubLabel = 'Gate open',
  class: cls = '',
  bg = 'paper',
} = Astro.props;
const perfBg = bg === 'night' ? 'var(--color-night)' : bg === 'surface' ? 'var(--color-surface)' : 'var(--color-paper)';
---
<aside class:list={['pass card card-raised', cls]} style={`--perf-bg:${perfBg}`} aria-label="Get the Planeology app">
  <div class="pass-main">
    <p class="label text-primary mb-2">{eyebrow}</p>
    <h2 class="font-display text-[1.75rem] md:text-[2rem] leading-[1.05] font-bold text-ink m-0">{title}</h2>
    <p class="mt-2.5 mb-4 text-ink-secondary text-[1.0625rem] leading-relaxed max-w-[44ch]">{body}</p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <StoreBadge ct={ct} />
      <p class="m-0 text-[0.8125rem] text-ink-muted">
        {counts.lessons} lessons · {counts.questions} questions · {counts.aircraft} aircraft · iPhone
      </p>
    </div>
  </div>
  <div class="perf-y hidden md:block"></div>
  <div class="perf-x md:hidden"></div>
  <div class="pass-stub">
    <p class="label mb-1">{stubLabel}</p>
    <p class="font-display text-xl font-bold text-ink m-0 mb-3">iPhone · {NOUNS.pass}</p>
    <div class="hidden md:block">
      <QrCode ct={ct} size={104} />
      <p class="label mt-2 !text-[0.625rem] !tracking-[0.1em] !normal-case max-w-[12ch] leading-snug">Scan to get it on your iPhone</p>
    </div>
    <p class="md:hidden m-0 text-ink-muted text-sm">Short lessons. A quiz after each. Five questions a day.</p>
  </div>
</aside>

<style>
  .pass {
    display: grid;
    overflow: visible;
    padding: 0;
  }
  .pass-main { padding: 1.5rem 1.5rem 1.5rem; }
  .pass-stub { padding: 1.25rem 1.5rem 1.5rem; }
  @media (min-width: 48rem) {
    .pass { grid-template-columns: 1fr auto 11.5rem; align-items: stretch; }
    .pass-main { padding: 1.75rem 2rem; }
    .pass-stub { padding: 1.75rem 1.5rem; display: grid; align-content: start; }
  }
</style>
