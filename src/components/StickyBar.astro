---
/**
 * StickyBar — a slim mobile bar that appears after ~35% scroll on article pages.
 * Fixed, so it causes no layout shift; dismissal lasts the page view only;
 * nothing is stored; respects the bottom safe area.
 */
import { storeLink, type Campaign } from '@/config';
import Logo from '@/components/Logo.astro';
interface Props { ct: Campaign }
const { ct } = Astro.props;
---
<div class="sticky-bar md:hidden" id="sticky-bar" hidden>
  <div class="sticky-bar-inner">
    <Logo class="h-8 w-8 shrink-0" />
    <p class="m-0 text-[0.9375rem] font-semibold leading-tight text-ink grow">Learn aviation in short lessons</p>
    <a href={storeLink(ct)} rel="noopener" class="btn btn-primary !min-h-9 !px-3.5 text-[0.9375rem]">Get</a>
    <button type="button" class="sticky-close" aria-label="Dismiss" data-dismiss>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</div>

<style>
  .sticky-bar {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 50;
    padding: 0.5rem max(0.75rem, env(safe-area-inset-left, 0px)) max(0.5rem, env(safe-area-inset-bottom, 0px)) max(0.75rem, env(safe-area-inset-right, 0px));
    transform: translateY(110%);
    transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .sticky-bar.is-shown { transform: none; }
  .sticky-bar-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raised);
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
  }
  .sticky-close {
    display: inline-grid; place-items: center;
    width: 2.25rem; height: 2.25rem;
    border: 0; border-radius: 999px; background: transparent; color: var(--color-ink-muted);
    cursor: pointer;
  }
  .sticky-close:hover { background: var(--color-sunken); color: var(--color-ink); }
  @media (prefers-reduced-motion: reduce) { .sticky-bar { transition: none; } }
</style>

<script>
  const bar = document.getElementById('sticky-bar');
  if (bar) {
    let dismissed = false;
    let shown = false;
    const update = () => {
      if (dismissed) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      const want = ratio > 0.35 && ratio < 0.96;
      if (want && !shown) {
        bar.hidden = false;
        requestAnimationFrame(() => bar.classList.add('is-shown'));
        shown = true;
      } else if (!want && shown) {
        bar.classList.remove('is-shown');
        shown = false;
      }
    };
    bar.querySelector('[data-dismiss]')?.addEventListener('click', () => {
      dismissed = true;
      bar.classList.remove('is-shown');
      setTimeout(() => (bar.hidden = true), 350);
    });
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
